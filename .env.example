FLASK_APP=run.py
FLASK_DEBUG=1
# Usa una clave propia en el servidor. Nunca subas el archivo .env real a Git.
SECRET_KEY=cambia-esta-clave
COOKIE_SECURE=0

DEFAULT_ADMIN_NICKNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Desarrollo SQLite opcional (ruta relativa al directorio instance de Flask):
# DATABASE_URL=sqlite:///restobar.sqlite3
# En un servidor, configura MySQL con DATABASE_URL o los campos DB_* siguientes.

DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restobar

# Integración opcional de Hacienda: solo pruebas 00, desactivada por defecto.
# El firmador oficial y su certificado se instalan por separado.
# Las contraseñas reales van en configuración segura fuera de Git.
DTE_TRANSMISSION_ENABLED=0
DTE_ENVIRONMENT=00
DTE_SIGNER_URL=http://127.0.0.1:8113/firmardocumento/
# DTE_API_USER=
# DTE_API_PASSWORD=
# DTE_SIGNER_PASSWORD=
# Los esquemas oficiales incluidos se verifican sin DTE_SCHEMA_PATH.
